# Copie este arquivo para ".env" e ajuste os valores.

# String de conexão do MySQL (usuário/senha vêm do docker-compose.yml,
# ou do seu servidor MySQL real em produção).
DATABASE_URL=mysql+pymysql://sma_app:senha_forte@localhost:3306/sma_dashboard

# Chave secreta para assinar os tokens JWT. Troque por um valor aleatório
# longo em produção (ex: `python -c "import secrets; print(secrets.token_hex(32))"`).
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-bem-longa
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Caminho completo da planilha na máquina onde a API roda (o mesmo caminho
# que já é usado em update_and_publish.py).
EXCEL_IMPORT_PATH=C:\Users\CARDOZO\Documents\Airton Augusto\Programação(SM&A).xlsx
